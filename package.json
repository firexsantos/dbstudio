{
  "name": "dbstudio",
  "productName": "DBStudio",
  "version": "0.2.0",
  "description": "Manajer database MySQL/MariaDB, PostgreSQL & SQLite — SSH tunnel, ERD, salin tabel antar server, schema sync.",
  "author": {
    "name": "Firman Santosa",
    "email": "admin@sifirman.com",
    "url": "https://sifirman.com"
  },
  "homepage": "https://sifirman.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/firexsantos/dbstudio.git"
  },
  "bugs": {
    "url": "https://github.com/firexsantos/dbstudio/issues"
  },
  "desktopName": "dbstudio.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "dbstudio": "server.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "app": "electron .",
    "dist": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis --x64",
    "demo": "node --disable-warning=ExperimentalWarning scripts/make-demo.js",
    "selftest": "node --disable-warning=ExperimentalWarning scripts/selftest.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "codemirror": "5.65.19",
    "express": "4.21.2",
    "lucide": "1.58.0",
    "mysql2": "3.11.5",
    "pg": "8.13.1",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sifirman.dbstudio",
    "productName": "DBStudio",
    "copyright": "© 2026 Firman Santosa",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "demo/**",
      "electron/**",
      "build/icons/**",
      "package.json",
      "!**/*.map",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icons",
      "executableName": "dbstudio",
      "synopsis": "Manajer database MySQL, PostgreSQL & SQLite",
      "maintainer": "Firman Santosa <admin@sifirman.com>",
      "vendor": "Firman Santosa",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/256x256.png",
      "legalTrademarks": "DBStudio — Firman Santosa"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DBStudio",
      "uninstallDisplayName": "DBStudio",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "language": "1057"
    }
  }
}
